# Copy to .env and replace the placeholders. NEVER commit .env.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production                     # development | test | production
JWT_SECRET_KEY=YOUR_SECRET_HERE            # required, >= 32 chars; app refuses to start otherwise
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./tasks.db          # e.g. postgresql+psycopg://user:YOUR_DB_PASSWORD@db:5432/tasks

CORS_ORIGINS=https://your-frontend.example.com   # comma-separated, "*" is rejected
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

COOKIE_SECURE=true                          # set false ONLY for plain-http local development
COOKIE_SAMESITE=strict

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=5/minute
TASK_RATE_LIMIT=100/minute
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0   # needed when running multiple replicas
